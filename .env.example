# Generate a unique value with: openssl rand -hex 32
# RelayOps rejects a missing token and any token shorter than 32 characters.
RELAYOPS_ADMIN_TOKEN=

# Public builds fail closed. Enable each capability only after isolated readback tests.
RELAYOPS_REMOTE_WRITES_ENABLED=false
RELAYOPS_AUTOMATION_ENABLED=false
RELAYOPS_BACKGROUND_WORKERS_ENABLED=false

RELAYOPS_LISTEN=0.0.0.0:18180
RELAYOPS_DATA_DIR=/var/lib/relayops
RELAYOPS_REQUEST_TIMEOUT=30s
RELAYOPS_COLLECTOR_WORKERS=2
TZ=Asia/Hong_Kong
